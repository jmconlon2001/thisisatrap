<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Email-client support data for the HTML check (Can I email, MIT). Refresh with tools/Update-CanIEmail.ps1. -->
    <Content Remove="Data\**" />
    <EmbeddedResource Include="Data\caniemail.json" LogicalName="ThisIsATrap.Data.caniemail.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>ThisIsATrap</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.11.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="MimeKit" Version="5.0.0" />
    <PackageReference Include="SmtpServer" Version="11.1.0" />
  </ItemGroup>

</Project>
