{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SmtpServer": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MailTrap": {
    "SmtpPort": 25,
    "ServerName": "mailtrap.local",
    "MaxMessageSizeMb": 50,
    "DataPath": "App_Data"
  }
}
